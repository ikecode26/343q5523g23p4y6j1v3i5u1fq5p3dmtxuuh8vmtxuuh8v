/* Thin */
@font-face {
  font-family: "serif";
  src: url("./serift.ttc") format("truetype-collection");
  font-weight: 100;
  font-style: normal;
  font-display: swap;
}

/* Regular */
@font-face {
  font-family: "serif";
  src: url("https://cloud.ocd.ccwu.cc/direct/1n17494e04k446h4030702v1z03q5smtxuws7cmtxuws7c/serif.ttc") format("truetype-collection");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

/* Bold */
@font-face {
  font-family: "serif";
  src: url("./serifb.ttc") format("truetype-collection");
  font-weight: 700;
  font-style: normal;
  font-display: swap;
}

